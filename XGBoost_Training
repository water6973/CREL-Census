import pandas as pd
from xgboost import XGBClassifier
from sklearn.metrics import classification_report

# Load your dataset
df = pd.read_csv("/Users/vedikabaradwaj/Documents/CREL-Census/POI_data_quarterly.csv")

# --- Feature Engineering ---

# Convert dates
df['OPENED_ON'] = pd.to_datetime(df['OPENED_ON'], errors='coerce')
df['CURRENT_QUARTER_START'] = pd.to_datetime(df['CURRENT_QUARTER_START'], errors='coerce')

# Season / time features
df['QUARTER_OF_YEAR'] = df['CURRENT_QUARTER_START'].dt.quarter
df['YEAR'] = df['CURRENT_QUARTER_START'].dt.year

# Encode industry code
df['NAICS_CODE'] = pd.to_numeric(df['NAICS_CODE'], errors='coerce')
df['NAICS_2DIGIT'] = (df['NAICS_CODE'] // 10000).astype('Int64')  # broad industry group

# Encode county as a category
df['COUNTY_CODE'] = df['COUNTY'].astype('category').cat.codes

# Sort by time to ensure chronological order
df = df.sort_values('CURRENT_QUARTER_START')

# --- Train/Test Split ---
split_index = int(len(df) * 0.8)
train = df.iloc[:split_index]
test = df.iloc[split_index:]

# --- Features and Target ---
drop_cols = ['CLOSED_NEXT_QUARTER', 'NAME', 'BRAND', 'OPENED_ON',
             'CLOSED_ON', 'ADDRESS', 'CURRENT_QUARTER',
             'CURRENT_QUARTER_START', 'COUNTY', 'NAICS_CODE',
             'NAICS_CODE_2022']

X_train = train.drop(columns=drop_cols)
Y_train = train['CLOSED_NEXT_QUARTER']
X_test = test.drop(columns=drop_cols)
Y_test = test['CLOSED_NEXT_QUARTER']

print("Features being used:", X_train.columns.tolist())

# --- Train Model ---
ratio = (Y_train == 0).sum() / (Y_train == 1).sum()

xgb = XGBClassifier(
    scale_pos_weight=ratio,
    n_estimators=500,
    learning_rate=0.01,
    max_depth=6,
    eval_metric='aucpr',
    random_state=42
)
xgb.fit(X_train, Y_train)

# --- Evaluate at multiple thresholds ---
probabilities = xgb.predict_proba(X_test)[:, 1]

for threshold in [0.1, 0.2, 0.3, 0.5]:
    Y_pred = (probabilities > threshold).astype(int)
    print(f"\n--- Threshold: {threshold} ---")
    print(classification_report(Y_test, Y_pred))

# --- Feature Importance ---
import pandas as pd
feature_importance = pd.Series(
    xgb.feature_importances_,
    index=X_train.columns
).sort_values(ascending=False)
print("\nFeature Importances:")
print(feature_importance)